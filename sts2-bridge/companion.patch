diff --git a/LocalHttpListener.cs b/LocalHttpListener.cs
new file mode 100644
index 0000000..403950e
--- /dev/null
+++ b/LocalHttpListener.cs
@@ -0,0 +1,158 @@
+global using HttpListener = STS2_MCP.LocalHttpListener;
+global using HttpListenerContext = STS2_MCP.LocalHttpContext;
+global using HttpListenerRequest = STS2_MCP.LocalHttpRequest;
+global using HttpListenerResponse = STS2_MCP.LocalHttpResponse;
+
+using System;
+using System.Collections.Generic;
+using System.Collections.Specialized;
+using System.IO;
+using System.Linq;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Web;
+
+namespace STS2_MCP;
+
+// The upstream HTTP.sys listener needs administrator-created URL reservations on
+// Windows. This deliberately small HTTP/1.1, connection-close transport supports
+// the local JSON bridge without changing machine-wide HTTP configuration.
+internal sealed class LocalHttpListener
+{
+    private TcpListener? _server;
+    public List<string> Prefixes { get; } = new();
+    private volatile bool _isListening;
+    public bool IsListening => _isListening;
+
+    public void Start()
+    {
+        var uris = Prefixes.Select(prefix => new Uri(prefix)).ToArray();
+        if (uris.Length == 0 || uris.Any(uri => uri.Scheme != "http" || !uri.IsLoopback || uri.Port != uris[0].Port))
+            throw new InvalidOperationException("Only one loopback HTTP port is supported");
+        _server = new TcpListener(IPAddress.Loopback, uris[0].Port);
+        _server.Start(16);
+        _isListening = true;
+    }
+
+    public void Stop() { _isListening = false; _server?.Stop(); }
+    public void Close() => Stop();
+
+    public LocalHttpContext GetContext()
+    {
+        while (IsListening)
+        {
+            TcpClient client;
+            try { client = _server!.AcceptTcpClient(); }
+            catch (SocketException) when (!IsListening) { throw new HttpListenerException(); }
+            catch (InvalidOperationException) when (!IsListening) { throw new HttpListenerException(); }
+            client.ReceiveTimeout = 5000;
+            client.SendTimeout = 5000;
+            try
+            {
+                var request = LocalHttpRequest.Read(client.GetStream(), ((IPEndPoint)client.Client.LocalEndPoint!).Port);
+                return new LocalHttpContext(request, new LocalHttpResponse(client));
+            }
+            catch (Exception error) when (error is IOException or FormatException or ArgumentException)
+            {
+                using (client)
+                {
+                    try
+                    {
+                        var response = Encoding.ASCII.GetBytes("HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Length: 0\r\n\r\n");
+                        client.GetStream().Write(response);
+                    }
+                    catch (IOException) { }
+                }
+            }
+        }
+        throw new HttpListenerException();
+    }
+}
+
+internal sealed record LocalHttpContext(LocalHttpRequest Request, LocalHttpResponse Response);
+
+internal sealed class LocalHttpRequest
+{
+    public string HttpMethod { get; private init; } = "";
+    public Uri Url { get; private init; } = null!;
+    public NameValueCollection Headers { get; private init; } = new(StringComparer.OrdinalIgnoreCase);
+    public NameValueCollection QueryString => HttpUtility.ParseQueryString(Url.Query);
+    public Encoding ContentEncoding => Encoding.UTF8;
+    public string? ContentType => Headers["Content-Type"];
+    public long ContentLength64 => InputStream.Length;
+    public Stream InputStream { get; private init; } = Stream.Null;
+
+    internal static LocalHttpRequest Read(Stream stream, int port)
+    {
+        // Read no further than the header terminator so no request body bytes are
+        // lost to a text reader's buffering. Bound both headers and request body.
+        var buffer = new List<byte>();
+        while (true)
+        {
+            int value = stream.ReadByte();
+            if (value < 0 || buffer.Count >= 16384) throw new FormatException("Incomplete or excessive HTTP headers");
+            buffer.Add((byte)value);
+            int size = buffer.Count;
+            if (size >= 4 && buffer[size - 4] == 13 && buffer[size - 3] == 10 && buffer[size - 2] == 13 && buffer[size - 1] == 10) break;
+        }
+        var lines = Encoding.ASCII.GetString(buffer.ToArray()).Split("\r\n");
+        var first = lines[0].Split(' ');
+        if (first.Length != 3 || first[2] != "HTTP/1.1" || !first[1].StartsWith('/') || first[1].StartsWith("//"))
+            throw new FormatException("Expected an HTTP/1.1 origin-form request");
+        var headers = new NameValueCollection(StringComparer.OrdinalIgnoreCase);
+        foreach (var line in lines.Skip(1).Where(line => line.Length > 0))
+        {
+            int colon = line.IndexOf(':');
+            if (colon <= 0 || char.IsWhiteSpace(line[0])) throw new FormatException("Malformed header");
+            string name = line[..colon];
+            if (headers[name] != null) throw new FormatException("Duplicate header");
+            headers[name] = line[(colon + 1)..].Trim();
+        }
+        string? host = headers["Host"];
+        if (host != $"localhost:{port}" && host != $"127.0.0.1:{port}") throw new FormatException("Unexpected Host");
+        if (headers["Transfer-Encoding"] != null || headers["Expect"] != null) throw new FormatException("Unsupported body encoding");
+        int length = 0;
+        if (headers["Content-Length"] is string rawLength && (!int.TryParse(rawLength, out length) || length < 0 || length > 32768))
+            throw new FormatException("Body exceeds 32 KiB");
+        var body = new byte[length];
+        stream.ReadExactly(body);
+        return new LocalHttpRequest
+        {
+            HttpMethod = first[0],
+            Url = new Uri($"http://{host}{first[1]}"),
+            Headers = headers,
+            InputStream = new MemoryStream(body, writable: false)
+        };
+    }
+}
+
+internal sealed class LocalHttpResponse
+{
+    private readonly TcpClient _client;
+    private bool _closed;
+    public WebHeaderCollection Headers { get; } = new();
+    public int StatusCode { get; set; } = 200;
+    public string ContentType { get; set; } = "application/json";
+    public long ContentLength64 { get; set; }
+    public MemoryStream OutputStream { get; } = new();
+    internal LocalHttpResponse(TcpClient client) => _client = client;
+
+    public void Close()
+    {
+        if (_closed) return;
+        _closed = true;
+        using (_client)
+        using (OutputStream)
+        {
+            var stream = _client.GetStream();
+            var header = new StringBuilder($"HTTP/1.1 {StatusCode} {((HttpStatusCode)StatusCode)}\r\nConnection: close\r\nContent-Type: {ContentType}\r\nContent-Length: {OutputStream.Length}\r\n");
+            foreach (string name in Headers.AllKeys)
+                header.Append(name).Append(": ").Append(Headers[name]).Append("\r\n");
+            header.Append("\r\n");
+            stream.Write(Encoding.UTF8.GetBytes(header.ToString()));
+            OutputStream.Position = 0;
+            OutputStream.CopyTo(stream);
+        }
+    }
+}
