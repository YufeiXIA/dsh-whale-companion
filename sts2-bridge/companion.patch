+    private static CompanionDispatch PrepareCompanionFlowAction(string action, Dictionary<string, JsonElement> data,
+        RunState run, Player player)
+    {
+        var overlay = NOverlayStack.Instance?.Peek();
+        Func<bool> observed;
+        Func<Dictionary<string, object?>> execute = () => ExecuteMultiplayerAction(action, data);
+
+        switch (action)
+        {
+            case "advance_dialogue":
+            {
+                if (overlay != null || IsMapScreenOpenOrVisible() || run.CurrentRoom is not EventRoom
+                    || NEventRoom.Instance is not { } room)
+                    throw new ArgumentException("Local ancient dialogue is not active");
+                var layout = FindFirst<NAncientEventLayout>(room) ?? throw new ArgumentException("No ancient dialogue layout");
+                var hitbox = layout.GetNodeOrNull<NClickableControl>("%DialogueHitbox");
+                RequireUsable(hitbox);
+                int line = layout.Get("_currentDialogueLine").AsInt32();
+                observed = () => layout.Get("_currentDialogueLine").AsInt32() != line || !hitbox!.IsVisibleInTree();
+                break;
+            }
+            case "claim_reward":
+            {
+                if (overlay is not NRewardsScreen screen) throw new ArgumentException("Local rewards screen is not open");
+                var buttons = FindAll<NRewardButton>(screen).Where(b => b.IsEnabled && b.Reward != null).ToList();
+                var button = At(buttons, data, "index");
+                RequireUsable(button);
+                var reward = button.Reward!;
+                if (!ReferenceEquals(reward.Player, player) || reward.SuccessfullySelected)
+                    throw new ArgumentException("Reward does not belong to the local player or was already selected");
+                // Opening a decision screen is the expected effect of claiming a
+                // card/removal reward; that later decision gets its own receipt.
+                observed = () => reward.SuccessfullySelected
+                    || reward is CardReward && NOverlayStack.Instance?.Peek() is NCardRewardSelectionScreen current
+                        && ReferenceEquals(AccessTools.Field(typeof(CardReward), "_currentlyShownScreen")?.GetValue(reward), current)
+                    || reward is CardRemovalReward && NewCompanionSelection(overlay);
+                break;
+            }
+            case "select_card_reward":
+            {
+                if (overlay is not NCardRewardSelectionScreen screen) throw new ArgumentException("Card reward is not open");
+                var holder = At(FindAllSortedByPosition<NCardHolder>(screen), data, "card_index");
+                var card = holder.CardModel ?? throw new ArgumentException("Card is unavailable");
+                if (!ReferenceEquals(card.Owner, player) || !CompanionCardClickable(holder))
+                    throw new ArgumentException("Card is not a visible local reward");
+                observed = () => player.Deck.Cards.Contains(card);
+                break;
+            }
+            case "skip_card_reward":
+            {
+                if (overlay is not NCardRewardSelectionScreen screen) throw new ArgumentException("Card reward is not open");
+                var skip = FindAll<NCardRewardAlternativeButton>(screen).FirstOrDefault();
+                RequireUsable(skip);
+                observed = () => !ReferenceEquals(NOverlayStack.Instance?.Peek(), screen);
+                break;
+            }
+            case "proceed":
+            {
+                if (IsMapScreenOpenOrVisible()) throw new ArgumentException("Local map is already open");
+                NProceedButton? button = overlay is NRewardsScreen rewards ? FindFirst<NProceedButton>(rewards) : null;
+                if (overlay != null && button == null) throw new ArgumentException("Resolve the local selection before proceeding");
+                if (button == null && run.CurrentRoom is RestSiteRoom restModel) button = CompanionRestRoom(restModel)?.ProceedButton;
+                if (button == null && run.CurrentRoom is MerchantRoom)
+                {
+                    if (NMerchantRoom.Instance?.Inventory?.IsOpen == true)
+                        throw new ArgumentException("Use close_shop before proceed");
+                    button = NMerchantRoom.Instance?.ProceedButton;
+                }
+                if (button == null && run.CurrentRoom is TreasureRoom) button = CompanionTreasureRoom()?.ProceedButton;
+                if (button == null && run.CurrentRoom is EventRoom { CanonicalEvent: FakeMerchant })
+                {
+                    var merchant = CompanionFakeMerchant();
+                    if (merchant != null && FindFirst<NMerchantInventory>(merchant)?.IsOpen == true)
+                        throw new ArgumentException("Use close_shop before proceed");
+                    if (merchant != null) button = FindFirst<NProceedButton>(merchant);
+                }
+                RequireUsable(button);
+                execute = () => { button!.ForceClick(); return CompanionSubmitted(); };
+                observed = () => IsMapScreenOpenOrVisible();
+                break;
+            }
+            case "choose_event_option":
+            {
+                if (overlay != null || IsMapScreenOpenOrVisible() || run.CurrentRoom is not EventRoom)
+                    throw new ArgumentException("Local event options are not active");
+                var room = NEventRoom.Instance ?? throw new ArgumentException("Event UI is unavailable");
+                var button = At(FindAll<NEventOptionButton>(room), data, "index");
+                RequireUsable(button);
+                if (button.Option.IsLocked || button.Option.WasChosen || !ReferenceEquals(button.Event.Owner, player))
+                    throw new ArgumentException("Event option is locked, chosen, or belongs to another player");
+                var evidence = new CompanionAsyncEvidence(button.Option);
+                _companionAsync = evidence;
+                // Finished events create a UI-only proceed option outside CurrentOptions.
+                // It opens the local map directly, including in shared events.
+                if (button.Option.IsProceed)
+                {
+                    observed = () => evidence.Task?.IsCompletedSuccessfully == true && IsMapScreenOpenOrVisible();
+                    break;
+                }
+                var sync = RunManager.Instance.EventSynchronizer;
+                bool shared = sync.IsShared;
+                int index = button.Event.CurrentOptions.ToList().FindIndex(o => ReferenceEquals(o, button.Option));
+                if (index < 0) throw new ArgumentException("Event option is not in the local event model");
+                if (shared && sync.GetPlayerVote(player) == (uint)index)
+                    throw new ArgumentException("Local player already voted for this event option");
+                bool voted = false;
+                void VoteChanged(Player voter)
+                {
+                    if (ReferenceEquals(voter, player) && sync.GetPlayerVote(player) == (uint)index) voted = true;
+                }
+                execute = () =>
+                {
+                    sync.PlayerVoteChanged += VoteChanged;
+                    try { return ExecuteMultiplayerAction(action, data); }
+                    finally { sync.PlayerVoteChanged -= VoteChanged; }
+                };
+                observed = () => shared ? voted || sync.GetPlayerVote(player) == (uint)index
+                    : evidence.Task?.IsCompletedSuccessfully == true
+                        || evidence.Task is { IsFaulted: false, IsCanceled: false } && NewCompanionSelection(overlay);
+                break;
+            }
+            case "choose_rest_option":
+            {
+                if (overlay != null || IsMapScreenOpenOrVisible() || run.CurrentRoom is not RestSiteRoom model)
+                    throw new ArgumentException("Local rest options are not active");
+                var room = CompanionRestRoom(model) ?? throw new ArgumentException("Local rest UI is not ready");
+                var button = At(FindAll<NRestSiteButton>(room), data, "index");
+                RequireUsable(button);
+                if (!ReferenceEquals(button.Option, At(model.Options, data, "index")))
+                    throw new ArgumentException("Rest option does not match the current local model");
+                if (!button.Option.IsEnabled) throw new ArgumentException("Rest option is disabled");
+                var evidence = new CompanionAsyncEvidence(button);
+                _companionAsync = evidence;
+                observed = () => CompanionLedger.SuccessfulEffectTask(evidence.Task as Task<bool>) && room.ProceedButton.IsEnabled
+                    || evidence.Task is { IsFaulted: false, IsCanceled: false } && NewCompanionSelection(overlay);
+                break;
+            }
+            case "select_card":
+            {
+                if (overlay is NCardGridSelectionScreen grid)
+                {
+                    if (BuildCardSelectState(grid, run)["preview_showing"] is true)
+                        throw new ArgumentException("Confirm or cancel the current preview before choosing another card");
+                    var holder = At(FindAllSortedByPosition<NGridCardHolder>(grid), data, "index");
+                    if (!CompanionCardClickable(holder)) throw new ArgumentException("Selected card is not currently clickable");
+                    var selectedCard = holder.CardModel;
+                    bool wasSelected = CompanionSelectedCards(grid).Contains(selectedCard);
+                    var completion = grid.CardsSelected();
+                    string before = CompanionSelectionState(grid, run);
+                    observed = () => completion.IsCompletedSuccessfully
+                        || ReferenceEquals(NOverlayStack.Instance?.Peek(), grid)
+                            && (CompanionSelectedCards(grid).Contains(selectedCard) != wasSelected
+                                || CompanionSelectionState(grid, run) != before);
+                }
+                else if (overlay is NChooseACardSelectionScreen choose)
+                {
+                    var holder = At(FindAllSortedByPosition<NGridCardHolder>(choose), data, "index");
+                    if (!CompanionCardClickable(holder)) throw new ArgumentException("Selected card is not currently clickable");
+                    observed = () => !ReferenceEquals(NOverlayStack.Instance?.Peek(), choose);
+                }
+                else throw new ArgumentException("Local card selection is not open");
+                break;
+            }
+            case "confirm_selection":
+            case "cancel_selection":
+            {
+                if (overlay is NCardGridSelectionScreen grid)
+                {
+                    var state = BuildCardSelectState(grid, run);
+                    string key = action == "confirm_selection" ? "can_confirm" : "can_cancel";
+                    if (state[key] is not true) throw new ArgumentException("Selection does not advertise " + key);
+                    var completion = grid.CardsSelected();
+                    string before = CompanionSelectionState(grid, run);
+                    observed = () => completion.IsCompletedSuccessfully
+                        || action == "cancel_selection" && (!ReferenceEquals(NOverlayStack.Instance?.Peek(), grid)
+                            || CompanionSelectionState(grid, run) != before);
+                }
+                else if (action == "cancel_selection" && overlay is NChooseACardSelectionScreen choose)
+                {
+                    if (BuildChooseCardState(choose, run)["can_skip"] is not true) throw new ArgumentException("Card choice cannot be skipped");
+                    observed = () => !ReferenceEquals(NOverlayStack.Instance?.Peek(), choose);
+                }
+                else throw new ArgumentException("Local card selection is not open");
+                break;
+            }
+            case "open_shop":
+            case "close_shop":
+            {
+                if (overlay != null || IsMapScreenOpenOrVisible()) throw new ArgumentException("Shop is covered by another screen");
+                Node ui;
+                NMerchantInventory inventory;
+                Action open;
+                bool desired = action == "open_shop";
+                if (run.CurrentRoom is MerchantRoom model)
+                {
+                    var merchant = CompanionMerchantRoom(model) ?? throw new ArgumentException("Local shop UI is not ready");
+                    ui = merchant; inventory = merchant.Inventory; open = merchant.OpenInventory;
+                }
+                else if (run.CurrentRoom is EventRoom { CanonicalEvent: FakeMerchant } && CompanionFakeMerchant() is { } fake)
+                {
+                    ui = fake;
+                    inventory = FindFirst<NMerchantInventory>(fake) ?? throw new ArgumentException("Shop inventory is unavailable");
+                    if (desired) RequireUsable(fake.MerchantButton);
+                    open = fake.MerchantButton.ForceClick;
+                }
+                else throw new ArgumentException("No local shop is active");
+                if (inventory.IsOpen == desired) throw new ArgumentException("Shop is already in the requested state");
+                var back = desired ? null : FindFirst<NBackButton>(ui);
+                if (!desired) RequireUsable(back);
+                execute = () => { if (desired) open(); else back!.ForceClick(); return CompanionSubmitted(); };
+                observed = () => inventory.IsOpen == desired;
+                break;
+            }
+            case "shop_purchase":
+            {
+                if (overlay != null || IsMapScreenOpenOrVisible()) throw new ArgumentException("Shop is covered by another screen");
+                MerchantInventory? inventory = null;
+                if (run.CurrentRoom is MerchantRoom merchant && NMerchantRoom.Instance?.Inventory?.IsOpen == true)
+                    inventory = merchant.GetLocalInventory();
+                else if (run.CurrentRoom is EventRoom eventRoom && (eventRoom.LocalMutableEvent ?? eventRoom.CanonicalEvent) is FakeMerchant fake
+                    && CompanionFakeMerchant() is { } fakeUi && FindFirst<NMerchantInventory>(fakeUi)?.IsOpen == true)
+                    inventory = fake.Inventory;
+                if (inventory == null) throw new ArgumentException("Use open_shop before purchasing");
+                var entry = At(inventory.AllEntries.ToList(), data, "index");
+                if (!entry.IsStocked || !entry.EnoughGold) throw new ArgumentException("Item is sold out or unaffordable");
+                Task<bool>? purchase = null;
+                execute = () => { purchase = entry.OnTryPurchaseWrapper(inventory); return CompanionSubmitted(); };
+                observed = () => CompanionLedger.SuccessfulEffectTask(purchase)
+                    || purchase is { IsFaulted: false, IsCanceled: false } && NewCompanionSelection(overlay);
+                break;
+            }
+            case "open_treasure":
+            {
+                if (overlay != null || IsMapScreenOpenOrVisible() || run.CurrentRoom is not TreasureRoom)
+                    throw new ArgumentException("Local treasure room is not active");
+                var room = CompanionTreasureRoom() ?? throw new ArgumentException("Treasure UI is unavailable");
+                var chest = room.GetNodeOrNull<NClickableControl>("Chest");
+                RequireUsable(chest);
+                bool wasVisible = room.GetNodeOrNull<NTreasureRoomRelicCollection>("%RelicCollection")?.Visible == true;
+                bool couldProceed = room.ProceedButton.IsEnabled;
+                execute = () => { chest!.ForceClick(); return CompanionSubmitted(); };
+                observed = () => !wasVisible && room.GetNodeOrNull<NTreasureRoomRelicCollection>("%RelicCollection")?.Visible == true
+                    || !couldProceed && room.ProceedButton.IsEnabled;
+                break;
+            }
+            case "claim_treasure_relic":
+            {
+                if (overlay != null || IsMapScreenOpenOrVisible() || run.CurrentRoom is not TreasureRoom)
+                    throw new ArgumentException("Local treasure choice is not active");
+                var room = CompanionTreasureRoom() ?? throw new ArgumentException("Treasure UI is unavailable");
+                var collection = room.GetNodeOrNull<NTreasureRoomRelicCollection>("%RelicCollection");
+                if (collection?.Visible != true) throw new ArgumentException("Use open_treasure first");
+                var holder = At(FindAll<NTreasureRoomRelicHolder>(collection).Where(h => h.IsEnabled && h.Visible).ToList(), data, "index");
+                RequireUsable(holder);
+                var relic = holder.Relic?.Model ?? throw new ArgumentException("Relic is unavailable");
+                var relics = RunManager.Instance.TreasureRoomRelicSynchronizer.CurrentRelics
+                    ?? throw new ArgumentException("Relic voting is inactive");
+                int realIndex = relics.ToList().FindIndex(r => ReferenceEquals(r, relic));
+                if (realIndex < 0) throw new ArgumentException("Relic is not in the current shared offer");
+                var evidence = new CompanionTreasureEvidence(player, relics, realIndex);
+                _companionTreasure = evidence;
+                observed = () => evidence.VoteConfirmed;
+                break;
+            }
+            default: throw new ArgumentException("Action is not in the companion allowlist");
+        }
+        return new CompanionDispatch(execute, observed);
+    }
+
+    private static T At<T>(IReadOnlyList<T> items, Dictionary<string, JsonElement> data, string key)
+    {
+        int index = RequiredIndex(data, key);
+        if (index >= items.Count) throw new ArgumentException($"'{key}' is outside the current local choices");
+        return items[index];
+    }
+
+    private static void RequireUsable(NClickableControl? control)
+    {
+        if (control == null || !control.IsEnabled || !control.IsVisibleInTree())
+            throw new ArgumentException("Local control is not visible and enabled");
+    }
+
+    private static bool NewCompanionSelection(object? previous)
+    {
+        var current = NOverlayStack.Instance?.Peek();
+        return !ReferenceEquals(current, previous)
+            && current is NCardRewardSelectionScreen or NCardGridSelectionScreen or NChooseACardSelectionScreen;
+    }
+
+    private static string CompanionSelectionState(NCardGridSelectionScreen screen, RunState run)
+    {
+        var state = BuildCardSelectState(screen, run);
+        // Restrict comparison to the local choice/preview, excluding descriptions
+        // or teammate-dependent card values that can change without our choice.
+        var selection = new Dictionary<string, object?>();
+        foreach (string key in new[] { "preview_showing", "can_confirm" })
+            if (state.TryGetValue(key, out var value)) selection[key] = value;
+        if (state.TryGetValue("preview_cards", out var previews) && previews is List<Dictionary<string, object?>> cards)
+            selection["preview_cards"] = cards.Select(c => new { id = c["id"], upgraded = c["is_upgraded"] }).ToArray();
+        return CompanionLedger.CanonicalJson(JsonSerializer.SerializeToElement(selection, _jsonOptions));
+    }
+
+    private static IEnumerable<CardModel> CompanionSelectedCards(NCardGridSelectionScreen screen)
+        => AccessTools.Field(screen.GetType(), "_selectedCards")?.GetValue(screen) as IEnumerable<CardModel>
+            ?? Array.Empty<CardModel>();
+
+    private static bool CompanionCardClickable(NCardHolder holder) => holder.IsVisibleInTree()
+        && AccessTools.Field(typeof(NCardHolder), "_isClickable")?.GetValue(holder) is true;
+
+    private static void AddCompanionFlowState(Dictionary<string, object?> state)
+    {
+        var top = NOverlayStack.Instance?.Peek();
+        if (top is Node cardScreen && (top is NCardRewardSelectionScreen or NCardGridSelectionScreen or NChooseACardSelectionScreen))
+        {
+            string key = top is NCardRewardSelectionScreen ? "card_reward" : "card_select";
+            if (state.TryGetValue(key, out var choiceValue) && choiceValue is Dictionary<string, object?> choice
+                && choice.TryGetValue("cards", out var cardsValue) && cardsValue is List<Dictionary<string, object?>> cards)
+            {
+                var holders = top is NCardRewardSelectionScreen
+                    ? FindAllSortedByPosition<NCardHolder>(cardScreen)
+                    : FindAllSortedByPosition<NGridCardHolder>(cardScreen).Cast<NCardHolder>().ToList();
+                var choices = holders.Select((holder, index) => (holder, index)).Where(p => p.holder.CardModel != null).ToList();
+                for (int i = 0; i < cards.Count && i < choices.Count; i++)
+                {
+                    cards[i]["index"] = choices[i].index;
+                    cards[i]["can_select"] = CompanionCardClickable(choices[i].holder);
+                }
+                if (top is NCardRewardSelectionScreen reward)
+                {
+                    var skip = FindAll<NCardRewardAlternativeButton>(reward).FirstOrDefault();
+                    choice["can_skip"] = skip?.IsEnabled == true && skip.IsVisibleInTree();
+                }
+            }
+        }
+        if (NOverlayStack.Instance?.Peek() is NCardGridSelectionScreen screen
+            && state.TryGetValue("card_select", out var selectionValue) && selectionValue is Dictionary<string, object?> selection)
+        {
+            var selected = CompanionSelectedCards(screen).ToHashSet();
+            selection["selected_indices"] = FindAllSortedByPosition<NGridCardHolder>(screen)
+                .Select((holder, index) => (holder, index)).Where(pair => selected.Contains(pair.holder.CardModel))
+                .Select(pair => pair.index).ToArray();
+        }
+        if (state.TryGetValue("event", out var eventValue) && eventValue is Dictionary<string, object?> eventState
+            && NEventRoom.Instance is { } room)
+        {
+            if (FindFirst<NAncientEventLayout>(room) is { } layout)
+                eventState["dialogue_line"] = layout.Get("_currentDialogueLine").AsInt32();
+            if (eventState["options"] is List<Dictionary<string, object?>> options)
+            {
+                var buttons = FindAll<NEventOptionButton>(room);
+                for (int i = 0; i < options.Count && i < buttons.Count; i++)
+                    options[i]["is_enabled"] = buttons[i].IsEnabled && buttons[i].IsVisibleInTree();
+            }
+        }
+        if (state.TryGetValue("rest_site", out var restValue) && restValue is Dictionary<string, object?> rest
+            && rest["options"] is List<Dictionary<string, object?>> restOptions)
+        {
+            var model = RunManager.Instance.DebugOnlyGetState()?.CurrentRoom as RestSiteRoom;
+            var restRoom = model == null ? null : CompanionRestRoom(model);
+            var buttons = restRoom == null ? new List<NRestSiteButton>() : FindAll<NRestSiteButton>(restRoom);
+            // Model options exist before the scene/buttons. Never leave their
+            // model-only enabled flag advertised during that loading window.
+            for (int i = 0; i < restOptions.Count; i++)
+                restOptions[i]["is_enabled"] = i < buttons.Count && i < model!.Options.Count
+                    && ReferenceEquals(buttons[i].Option, model.Options[i]) && buttons[i].Option.IsEnabled
+                    && buttons[i].IsEnabled && buttons[i].IsVisibleInTree();
+            rest["can_proceed"] = restRoom?.ProceedButton is { IsEnabled: true } proceed && proceed.IsVisibleInTree();
+        }
+    }
+
+    private static NTreasureRoom? CompanionTreasureRoom() => FindFirst<NTreasureRoom>(((SceneTree)Engine.GetMainLoop()).Root);
+    private static NRestSiteRoom? CompanionRestRoom(RestSiteRoom model)
+    {
+        var ui = NRestSiteRoom.Instance;
+        return ui != null && ui.IsNodeReady()
+            && ReferenceEquals(AccessTools.Field(typeof(NRestSiteRoom), "_room")?.GetValue(ui), model) ? ui : null;
+    }
+
+    private static NMerchantRoom? CompanionMerchantRoom(MerchantRoom model)
+    {
+        var ui = NMerchantRoom.Instance;
+        return ui != null && ReferenceEquals(ui.Room, model) && ui.IsNodeReady() && ui.Inventory != null ? ui : null;
+    }
+
+    private static NFakeMerchant? CompanionFakeMerchant() => NEventRoom.Instance is { } room ? FindFirst<NFakeMerchant>(room) : null;
+    private static Dictionary<string, object?> CompanionSubmitted() => new() { ["status"] = "ok" };
+}
