+
+    private sealed class CompanionEndTurnEvidence(Player player, object combat, int turn)
+    {
+        internal readonly Player Player = player;
+        internal readonly object Combat = combat;
+        internal readonly int Turn = turn;
+        internal bool Executed;
+    }
+
+    // On clients, RequestEnqueue serializes the submitted action and the host's
+    // response constructs a different object. Observe the authoritative execution.
+    // The installed game's ExecuteAction is synchronous, calls PlayerCmd.EndTurn
+    // only when TurnNumber matches, and returns Task.CompletedTask afterwards.
+    [HarmonyPatch(typeof(EndPlayerTurnAction), "ExecuteAction")]
+    private static class CompanionEndTurnExecutionPatch
+    {
+        private static void Prefix(Player ____player, int ____turnNumber, out CompanionEndTurnEvidence? __state)
+        {
+            __state = null;
+            var pending = _companionEndTurn;
+            if (pending != null && CompanionLedger.MatchesEndTurnExecution(
+                ReferenceEquals(pending.Player, ____player),
+                ReferenceEquals(pending.Combat, ____player.Creature.CombatState),
+                pending.Turn, ____turnNumber, ____player.PlayerCombatState?.TurnNumber))
+                __state = pending;
+        }
+
+        private static void Postfix(CompanionEndTurnEvidence? __state, Task __result)
+        {
+            if (__state != null && __result.IsCompletedSuccessfully)
+                __state.Executed = true;
+        }
+    }
+
+    private static void HandleCompanionRequest(HttpListenerRequest request, HttpListenerResponse response)
+    {
+        response.Headers["Cache-Control"] = "no-store";
+        // The raw API keeps its existing CORS behavior. This endpoint accepts only
+        // native clients or a browser on this exact loopback origin, plus a token.
+        string? origin = request.Headers["Origin"];
+        if (origin != null && (!Uri.TryCreate(origin, UriKind.Absolute, out var originUri)
+            || originUri.Scheme != "http" || !originUri.IsLoopback
+            || originUri.Authority != request.Url?.Authority))
+        {
+            SendError(response, 403, "Companion origin denied");
+            return;
+        }
+        if (origin != null)
+        {
+            response.Headers["Access-Control-Allow-Origin"] = origin;
+            response.Headers["Vary"] = "Origin";
+            response.Headers["Access-Control-Allow-Methods"] = "GET, POST, OPTIONS";
+            response.Headers["Access-Control-Allow-Headers"] = "Authorization, Content-Type";
+        }
+        if (request.HttpMethod == "OPTIONS")
+        {
+            response.StatusCode = 204;
+            response.Close();
+            return;
+        }
+        if (string.IsNullOrEmpty(_companionToken))
+        {
+            SendError(response, 503, "Companion disabled: set STS2_COMPANION_TOKEN before starting the game");
+            return;
+        }
+        if (request.Headers["Authorization"] != "Bearer " + _companionToken)
+        {
+            SendError(response, 401, "Companion token required");
+            return;
+        }
+        if (request.HttpMethod is not ("GET" or "POST"))
+        {
+            SendError(response, 405, "Method not allowed");
+            return;
+        }
+
+        Dictionary<string, JsonElement>? data = null;
+        string? payload = null;
+        if (request.HttpMethod == "POST")
+        {
+            if (request.ContentType?.Split(';')[0].Trim() != "application/json")
+            {
+                SendError(response, 415, "application/json required");
+                return;
+            }
+            const int maxBytes = 32768;
+            if (request.ContentLength64 > maxBytes)
+            {
+                SendError(response, 413, "Companion request exceeds 32 KiB");
+                return;
+            }
+            using var body = new MemoryStream();
+            byte[] buffer = new byte[4096];
+            int count;
+            while ((count = request.InputStream.Read(buffer, 0, buffer.Length)) != 0)
+            {
+                if (body.Length + count > maxBytes)
+                {
+                    SendError(response, 413, "Companion request exceeds 32 KiB");
+                    return;
+                }
+                body.Write(buffer, 0, count);
+            }
+            try
+            {
+                using var document = JsonDocument.Parse(body.ToArray());
+                if (document.RootElement.ValueKind != JsonValueKind.Object)
+                    throw new JsonException("Expected an object");
+                payload = CompanionLedger.CanonicalJson(document.RootElement);
+                data = document.RootElement.EnumerateObject().ToDictionary(p => p.Name, p => p.Value.Clone());
+                CompanionLedger.ValidateRequest(data);
+            }
+            catch (Exception ex) when (ex is JsonException or ArgumentException or FormatException)
+            {
+                SendError(response, 400, ex.Message);
+                return;
+            }
+        }
+
+        string? actionId = data == null ? request.QueryString["action_id"] : data["action_id"].GetString();
+        var task = RunOnMainThread(() =>
+        {
+            var snapshot = ReadCompanionSnapshot();
+            _companion.Observe(snapshot, DateTimeOffset.UtcNow);
+            object? receipt = data == null ? null : _companion.Submit(data, payload!, snapshot,
+                DateTimeOffset.UtcNow, () => PrepareCompanionAction(data));
+            // Freeze the entire result on the game thread. HTTP threads never read
+            // mutable receipts or game objects, including during serialization.
+            return JsonSerializer.Serialize(_companion.Envelope(snapshot, actionId, receipt), _jsonOptions);
+        });
+        if (!task.Wait(TimeSpan.FromSeconds(5)))
+        {
+            response.StatusCode = 202;
+            SendJson(response, new { status = "uncertain", action_id = actionId,
+                message = "Main-thread response timed out. Query this action_id; never resubmit with a new ID." });
+            return;
+        }
+        SendText(response, task.GetAwaiter().GetResult(), "application/json");
+    }
+
+    private static CompanionSnapshot ReadCompanionSnapshot()
+    {
+        var run = RunManager.Instance.IsInProgress ? RunManager.Instance.DebugOnlyGetState() : null;
+        var player = run == null ? null : LocalContext.GetMe(run);
+        var state = BuildMultiplayerGameState(allowUiActions: false);
+        state["game_version"] = CompanionGameVersion;
+        state["combat_in_progress"] = CombatManager.Instance.IsInProgress;
+        if (MegaCrit.Sts2.Core.Nodes.Screens.Overlays.NOverlayStack.Instance?.Peek() is
+            MegaCrit.Sts2.Core.Nodes.Screens.GameOverScreen.NGameOverScreen)
+        {
+            state["state_type"] = "game_over";
+            state["game_over"] = new Dictionary<string, object?> { ["win"] = run?.CurrentRoom?.IsVictoryRoom };
+        }
+        AddCompanionFlowState(state);
+        if (player != null && state.TryGetValue("player", out var playerState)
+            && playerState is Dictionary<string, object?> local)
+            local["deck"] = player.Deck.Cards.Select(card => BuildCardInfo(card)).ToArray();
+        var json = JsonSerializer.SerializeToElement(state, _jsonOptions);
+        return new CompanionSnapshot(run, player?.NetId.ToString(CultureInfo.InvariantCulture),
+            IsMultiplayerRun(), json);
+    }
+
+    // Read this process's installed build, never a second game's directory.
+    // Missing/malformed metadata stays unknown rather than assuming a release.
+    private static readonly string? CompanionGameVersion = ReadCompanionGameVersion();
+    private static string? ReadCompanionGameVersion()
+    {
+        try
+        {
+            var folder = Path.GetDirectoryName(Godot.OS.GetExecutablePath());
+            if (folder == null) return null;
+            using var json = JsonDocument.Parse(File.ReadAllText(Path.Combine(folder, "release_info.json")));
+            return json.RootElement.GetProperty("version").GetString();
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException or KeyNotFoundException or InvalidOperationException)
+        {
+            return null;
+        }
+    }
+
+    private static CompanionDispatch PrepareCompanionAction(Dictionary<string, JsonElement> data)
+    {
+        var tree = Godot.Engine.GetMainLoop() as Godot.SceneTree;
+        if (tree?.Root != null && IsAnyFtueVisible(tree.Root))
+            throw new ArgumentException("Blocking popup requires manual interaction before companion actions");
+        var run = RunManager.Instance.DebugOnlyGetState()!;
+        var player = LocalContext.GetMe(run)!;
+        string action = data["action"].GetString()!;
+        Func<bool> observed;
+        if (action == "play_card")
+        {
+            int index = RequiredIndex(data, "card_index");
+            var hand = player.PlayerCombatState?.Hand;
+            if (hand == null || index >= hand.Cards.Count)
+                throw new ArgumentException("Card index outside local hand");
+            var card = hand.Cards[index];
+            // Compare the actual local card object, not global battle changes.
+            var cancellation = new CompanionCardCancellationEvidence(card);
+            _companionCard = cancellation;
+            // Leaving hand precedes damage and hooks. Wait for the exact action
+            // task, except when its own local selection UI needs the next input.
+            observed = () => cancellation.EffectObserved(!hand.Cards.Contains(card),
+                NCombatRoom.Instance?.Ui?.Hand?.InCardPlay != true,
+                MegaCrit.Sts2.Core.Nodes.Screens.Overlays.NOverlayStack.Instance?.Peek() is
+                    MegaCrit.Sts2.Core.Nodes.Screens.CardSelection.NCardGridSelectionScreen or
+                    MegaCrit.Sts2.Core.Nodes.Screens.CardSelection.NChooseACardSelectionScreen or
+                    MegaCrit.Sts2.Core.Nodes.Screens.CardSelection.NChooseABundleSelectionScreen);
+            return new CompanionDispatch(() =>
+            {
+                _companionDispatchingCard = cancellation;
+                try { return ExecuteMultiplayerAction(action, data); }
+                finally { _companionDispatchingCard = null; }
+            }, observed, cancellation.NotExecutedReason);
+        }
+        else if (action == "end_turn")
+        {
+            var combat = player.Creature.CombatState;
+            if (combat == null) throw new ArgumentException("Not in combat");
+            int round = combat.RoundNumber;
+            var evidence = new CompanionEndTurnEvidence(player, combat, round);
+            _companionEndTurn = evidence;
+            // A teammate can end combat while this local request is still queued.
+            // Require positive local readiness in the exact submitted combat/round.
+            // If that transient state was missed, remain uncertain rather than infer
+            // success from a global transition. Client-side GameAction objects are
+            // serialized and replaced by the synchronizer, so their task cannot
+            // track the eventual authoritative action.
+            observed = () => evidence.Executed || CompanionLedger.EndTurnEffectObserved(
+                ReferenceEquals(player.Creature.CombatState, combat),
+                CombatManager.Instance.IsInProgress,
+                CombatManager.Instance.IsPlayerReadyToEndTurn(player), round, combat.RoundNumber);
+        }
+        else if (action is "use_potion" or "discard_potion")
+        {
+            int slot = RequiredIndex(data, "slot");
+            if (slot >= player.PotionSlots.Count) throw new ArgumentException("Potion slot outside local inventory");
+            var potion = player.GetPotionAtSlotIndex(slot);
+            if (potion == null) throw new ArgumentException("Local potion slot is empty");
+            if (action == "use_potion")
+            {
+                var evidence = new CompanionPotionUseEvidence(potion);
+                _companionPotionUse = evidence;
+                // IsQueued remains true after successful use in this game version.
+                // Removal precedes the effect, so wait for this exact use task too.
+                observed = () => evidence.EffectObserved(!ReferenceEquals(player.GetPotionAtSlotIndex(slot), potion));
+            }
+            else observed = () => !ReferenceEquals(player.GetPotionAtSlotIndex(slot), potion) && !potion.IsQueued;
+        }
+        else if (action == "choose_map_node")
+        {
+            int index = RequiredIndex(data, "index");
+            var map = NMapScreen.Instance;
+            if (map == null) throw new ArgumentException("Map is not open");
+            var options = FindAll<NMapPoint>(map).Where(p => p.State == MapPointState.Travelable && p.Point != null)
+                .OrderBy(p => p.Point!.coord.col).ToList();
+            if (index >= options.Count) throw new ArgumentException("Map index outside advertised options");
+            var coordinate = options[index].Point!.coord;
+            if (RunManager.Instance.MapSelectionSynchronizer.GetVote(player)?.coord == coordinate)
+                throw new ArgumentException("Local player already voted for this map node");
+            observed = TrackCompanionMapVote(player, run, coordinate);
+        }
+        else
+            return PrepareCompanionFlowAction(action, data, run, player);
+
+        return new CompanionDispatch(() => ExecuteMultiplayerAction(action, data), observed);
+    }
+
+    private static int RequiredIndex(Dictionary<string, JsonElement> data, string name)
+    {
+        if (!data.TryGetValue(name, out var value) || !value.TryGetInt32(out int index) || index < 0)
+            throw new ArgumentException($"'{name}' must be a nonnegative integer");
+        return index;
+    }
+}
+
+// All ledger methods are called on the game main thread. The small state machine
+// has no game dependencies so its concurrency/receipt rules can be tested alone.
+internal sealed class CompanionPotionUseEvidence(object potion)
+{
+    private System.Threading.Tasks.Task? _execution;
+
+    internal void RecordTask(object candidate, System.Threading.Tasks.Task execution)
+    {
+        if (ReferenceEquals(candidate, potion)) _execution = execution;
+    }
+
+    internal bool EffectObserved(bool removedFromSlot) => removedFromSlot && _execution?.IsCompletedSuccessfully == true;
+}
+
+internal sealed record CompanionSnapshot(object? Run, string? PlayerId, bool Multiplayer, JsonElement State);
+internal sealed record CompanionDispatch(Func<Dictionary<string, object?>> Execute, Func<bool> Observed,
+    Func<string?>? NotExecuted = null);
+
+internal sealed class CompanionCardCancellationEvidence(object card)
+{
+    internal readonly object Card = card;
+    internal object? Action;
+    internal System.Threading.Tasks.Task? ExecutionTask;
+    internal bool CancelledBeforeResources;
+    internal bool ResourcesStarted;
+
+    internal bool EffectObserved(bool leftHand, bool handIdle, bool selectionVisible) =>
+        ResourcesStarted && leftHand && handIdle &&
+        (ExecutionTask?.IsCompletedSuccessfully == true ||
+            ExecutionTask is { IsCompleted: false } && selectionVisible);
+
+    internal string? NotExecutedReason() => Action != null && CancelledBeforeResources && !ResourcesStarted
+        && ExecutionTask?.IsCompletedSuccessfully == true ? "play_card_cancelled_before_resources" : null;
+}
+
+// Reliable FIFO request/echo association, scoped to one game synchronizer.
+// Payload checks only validate the head; never search forward or resynchronize
+// after a missing/mismatched echo, even if later cards look identical.
+internal sealed class CompanionActionOrder
+{
+    private readonly Queue<(object Action, string Payload)> _sent = new();
+    private bool _valid = true;
+
+    internal void Sent(object action, string payload)
+    {
+        if (_valid) _sent.Enqueue((action, payload));
+    }
+
+    internal object? Confirm(string payload)
+    {
+        if (!_valid) return null;
+        if (!_sent.TryDequeue(out var sent) || sent.Payload != payload)
+        {
+            Invalidate();
+            return null;
+        }
+        return sent.Action;
+    }
+
+    internal void Invalidate()
+    {
+        _valid = false;
+        _sent.Clear();
+    }
+}
+
+internal sealed class CompanionLedger
+{
+    internal static readonly string[] AllowedActions = {
+        "play_card", "end_turn", "use_potion", "discard_potion", "choose_map_node",
+        "claim_reward", "select_card_reward", "skip_card_reward", "proceed", "choose_event_option", "advance_dialogue",
+        "choose_rest_option", "select_card", "confirm_selection", "cancel_selection", "open_shop",
+        "close_shop", "shop_purchase", "open_treasure", "claim_treasure_relic"
+    };
+    private readonly string _instanceId = Guid.NewGuid().ToString("N");
+    private readonly Dictionary<string, Receipt> _receipts = new(StringComparer.Ordinal);
+    private object? _run;
+    private string? _runId;
+    private string? _playerId;
+    private string? _lastState;
+    private long _version;
+    private Receipt? _pending;
+
+    internal static bool EndTurnEffectObserved(bool sameCombat, bool combatInProgress, bool localReady,
+        int submittedRound, int currentRound) => sameCombat && combatInProgress && localReady
+            && submittedRound == currentRound;
+
+    internal static bool MatchesEndTurnExecution(bool samePlayer, bool sameCombat,
+        int submittedTurn, int actionTurn, int? currentPlayerTurn) => samePlayer && sameCombat
+            && submittedTurn == actionTurn && actionTurn == currentPlayerTurn;
+
+    internal static bool SuccessfulEffectTask(System.Threading.Tasks.Task<bool>? task)
+        => task?.IsCompletedSuccessfully == true && task.Result;
+
+    private sealed class Receipt
+    {
+        public required string ActionId { get; init; }
+        public required string Status { get; set; }
+        public required string Message { get; set; }
+        public required string Payload { get; init; }
+        public long SubmittedVersion { get; init; }
+        public bool EffectObserved { get; set; }
+        public long? ObservedVersion { get; set; }
+        public DateTimeOffset Deadline { get; init; }
+        public Func<bool>? ObserveEffect { get; set; }
+        public Func<string?>? ObserveNotExecuted { get; set; }
+        public string? Reason { get; set; }
+        public object View() => new { action_id = ActionId, status = Status, message = Message, reason = Reason,
+            submitted_version = SubmittedVersion, effect_observed = EffectObserved, observed_version = ObservedVersion,
+            requires_reconciliation = Status == "uncertain" };
+    }
+
+    internal static void ValidateRequest(Dictionary<string, JsonElement> data)
+    {
+        foreach (string name in new[] { "instance_id", "run_id", "local_player_id", "action_id", "action", "expires_at" })
+            if (!data.TryGetValue(name, out var value) || value.ValueKind != JsonValueKind.String
+                || string.IsNullOrWhiteSpace(value.GetString()) || value.GetString()!.Length > 128)
+                throw new ArgumentException($"Missing or invalid '{name}'");
+        if (!data.TryGetValue("version", out var version) || version.ValueKind != JsonValueKind.Number
+            || !version.TryGetInt64(out long number) || number < 1)
+            throw new ArgumentException("Missing or invalid 'version'");
+        string expires = data["expires_at"].GetString()!;
+        bool hasOffset = expires.EndsWith("Z", StringComparison.Ordinal)
+            || expires.Length >= 6 && (expires[^6] == '+' || expires[^6] == '-') && expires[^3] == ':';
+        if (!hasOffset || !expires.Contains('T') || !DateTimeOffset.TryParse(expires, CultureInfo.InvariantCulture,
+            DateTimeStyles.RoundtripKind, out _))
+            throw new ArgumentException("expires_at must be an ISO 8601 timestamp with UTC offset");
+    }
+
+    internal void Observe(CompanionSnapshot snapshot, DateTimeOffset now)
+    {
+        if (!ReferenceEquals(_run, snapshot.Run) || _playerId != snapshot.PlayerId)
+        {
+            if (_pending != null)
+            {
+                _pending.Status = "uncertain";
+                _pending.Message = "Run or local player changed before effect confirmation";
+                _pending.ObserveEffect = null;
+                _pending.ObserveNotExecuted = null;
+            }
+            _pending = null;
+            _run = snapshot.Run;
+            _runId = _run == null ? null : Guid.NewGuid().ToString("N");
+            _playerId = snapshot.PlayerId;
+            _lastState = null;
+        }
+        string state = CanonicalJson(snapshot.State);
+        if (_lastState != state)
+        {
+            _lastState = state;
+            _version++;
+        }
+        if (_pending == null) return;
+        var pending = _pending;
+        try
+        {
+            // A matching authoritative cancellation may finish after the effect
+            // deadline. It can settle that same uncertain receipt without replay.
+            if (pending.ObserveNotExecuted?.Invoke() is { } reason)
+            {
+                pending.Status = "not_executed";
+                pending.Reason = reason;
+                pending.Message = "Exact local card action finished after cancellation before resources or card effects; observe again and make a new decision";
+                pending.ObservedVersion = _version;
+                pending.ObserveEffect = null;
+                pending.ObserveNotExecuted = null;
+                _pending = null;
+            }
+            else if (pending.Status != "accepted") return;
+            else if (pending.ObserveEffect!())
+            {
+                _pending.EffectObserved = true;
+                _pending.ObservedVersion = _version;
+                _pending.Message = "Expected local effect observed in subsequent state readback; not a claim of task completion";
+                _pending.ObserveEffect = null;
+                _pending.ObserveNotExecuted = null;
+                _pending = null;
+            }
+            else if (now >= _pending.Deadline)
+            {
+                _pending.Status = "uncertain";
+                _pending.Message = "Expected local effect was not observed within 10 seconds; manual reconciliation required";
+                _pending.ObserveEffect = null;
+            }
+        }
+        catch
+        {
+            pending.Status = "uncertain";
+            pending.Message = "Effect readback failed; manual reconciliation required";
+            pending.ObserveEffect = null;
+            pending.ObserveNotExecuted = null;
+        }
+    }
+
+    internal object Submit(Dictionary<string, JsonElement> data, string payload, CompanionSnapshot snapshot,
+        DateTimeOffset now, Func<CompanionDispatch> prepare)
+    {
+        string id = data["action_id"].GetString()!;
+        if (_receipts.TryGetValue(id, out var prior))
+            return prior.Payload == payload ? prior.View() : new { action_id = id, status = "rejected", message = "action_id was already used with a different payload" };
+        // Never evict IDs: an old retry must never accidentally execute again.
+        if (_receipts.Count >= 10000)
+            return new { action_id = id, status = "rejected", message = "Receipt capacity reached; restart the companion session" };
+        var receipt = new Receipt { ActionId = id, Payload = payload, Status = "rejected", Message = "",
+            SubmittedVersion = _version, Deadline = now.AddSeconds(10) };
+        _receipts.Add(id, receipt);
+
+        DateTimeOffset expires = DateTimeOffset.Parse(data["expires_at"].GetString()!, CultureInfo.InvariantCulture);
+        if (expires <= now || expires > now.AddSeconds(30))
+            receipt.Message = "Request expired or expires_at is more than 30 seconds ahead";
+        else if (data["instance_id"].GetString() != _instanceId || data["run_id"].GetString() != _runId
+            || data["local_player_id"].GetString() != _playerId || data["version"].GetInt64() != _version)
+            receipt.Message = "Stale instance, run, local player, or version";
+        else if (!snapshot.Multiplayer || snapshot.Run == null || snapshot.PlayerId == null)
+            receipt.Message = "An active multiplayer run and local player are required";
+        else if (_pending != null)
+            receipt.Message = "Previous action awaits effect confirmation or manual reconciliation";
+        else if (!AllowedActions.Contains(data["action"].GetString(), StringComparer.Ordinal))
+            receipt.Message = "Action is not in the companion allowlist; manual interaction required";
+        else if (snapshot.State.TryGetProperty("state_type", out var stateType)
+            && stateType.GetString() == "manual_interaction")
+            receipt.Message = "Current screen requires manual interaction";
+        else
+        {
+            CompanionDispatch dispatch;
+            try { dispatch = prepare(); }
+            catch (Exception ex)
+            {
+                receipt.Message = "Precondition failed: " + ex.Message;
+                return receipt.View();
+            }
+            // Register before dispatch: exceptions can happen after a game action
+            // was queued, and must never permit a second action or automatic retry.
+            _pending = receipt;
+            receipt.ObserveEffect = dispatch.Observed;
+            receipt.ObserveNotExecuted = dispatch.NotExecuted;
+            try
+            {
+                var result = dispatch.Execute();
+                if (result.TryGetValue("status", out var status) && status as string == "ok")
+                {
+                    receipt.Status = "accepted";
+                    receipt.Message = "Dispatched; awaiting expected local effect in subsequent readback";
+                }
+                else
+                {
+                    receipt.Message = result.TryGetValue("error", out var error) ? error?.ToString() ?? "Rejected" : "Rejected";
+                    receipt.ObserveEffect = null;
+                    receipt.ObserveNotExecuted = null;
+                    _pending = null;
+                }
+            }
+            catch (Exception ex)
+            {
+                receipt.Status = "uncertain";
+                receipt.Message = "Dispatch threw after it may have queued an action: " + ex.Message;
+                receipt.ObserveEffect = null;
+            }
+        }
+        return receipt.View();
+    }
+
+    internal object Envelope(CompanionSnapshot snapshot, string? actionId, object? receipt) => new Dictionary<string, object?>
+    {
+        ["instance_id"] = _instanceId, ["run_id"] = _runId, ["local_player_id"] = _playerId,
+        ["version"] = _version, ["state"] = snapshot.State, ["allowed_actions"] = AllowedActions,
+        ["pending_action_id"] = _pending?.ActionId,
+        ["requires_reconciliation"] = _pending?.Status == "uncertain",
+        ["receipt"] = receipt,
+        ["receipts"] = (actionId == null ? _receipts.Values.TakeLast(32)
+            : _receipts.Values.Where(r => r.ActionId == actionId)).Select(r => r.View()).ToArray()
+    };
+
+    internal static string CanonicalJson(JsonElement element)
+    {
+        using var stream = new MemoryStream();
+        using (var writer = new Utf8JsonWriter(stream)) Write(element, writer);
+        return Encoding.UTF8.GetString(stream.ToArray());
+
+        static void Write(JsonElement value, Utf8JsonWriter writer)
+        {
+            if (value.ValueKind == JsonValueKind.Object)
+            {
+                writer.WriteStartObject();
+                var names = new HashSet<string>(StringComparer.Ordinal);
+                foreach (var property in value.EnumerateObject().OrderBy(p => p.Name, StringComparer.Ordinal))
+                {
+                    if (!names.Add(property.Name)) throw new JsonException("Duplicate JSON property: " + property.Name);
+                    writer.WritePropertyName(property.Name);
+                    Write(property.Value, writer);
+                }
+                writer.WriteEndObject();
+            }
+            else if (value.ValueKind == JsonValueKind.Array)
+            {
+                writer.WriteStartArray();
+                foreach (var item in value.EnumerateArray()) Write(item, writer);
+                writer.WriteEndArray();
+            }
+            else value.WriteTo(writer);
+        }
+    }
+}
