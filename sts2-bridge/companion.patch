+
+namespace STS2_MCP;
+
+public static partial class McpMod
+{
+    private sealed class CompanionAsyncEvidence(object target)
+    {
+        internal readonly object Target = target;
+        internal Task? Task;
+    }
+
+    private static CompanionAsyncEvidence? _companionAsync;
+
+    private sealed class CompanionMapEvidence(Player player, MapLocation source, MapCoord destination, int generation)
+    {
+        internal readonly Player Player = player;
+        internal readonly MapLocation Source = source;
+        internal readonly MapCoord Destination = destination;
+        internal readonly int Generation = generation;
+        internal bool VoteConfirmed;
+    }
+
+    private static CompanionMapEvidence? _companionMap;
+
+    [HarmonyPatch(typeof(MapSelectionSynchronizer), nameof(MapSelectionSynchronizer.PlayerVotedForMapCoord))]
+    private static class CompanionMapVotePatch
+    {
+        private static void Prefix(MapSelectionSynchronizer __instance, Player player, MapLocation source,
+            MapVote? destination, MapLocation ____acceptingVotesFromSource, out CompanionMapEvidence? __state)
+        {
+            var pending = _companionMap;
+            __state = pending != null && ReferenceEquals(pending.Player, player)
+                && pending.Source == source && source == ____acceptingVotesFromSource
+                && destination?.coord == pending.Destination && destination?.mapGenerationCount == pending.Generation
+                && pending.Generation == __instance.MapGenerationCount ? pending : null;
+        }
+
+        private static void Postfix(CompanionMapEvidence? __state)
+        {
+            if (__state != null) __state.VoteConfirmed = true;
+        }
+    }
+
+    private static Func<bool> TrackCompanionMapVote(Player player, RunState run, MapCoord coordinate)
+    {
+        var sync = RunManager.Instance.MapSelectionSynchronizer;
+        var evidence = new CompanionMapEvidence(player, run.MapLocation, coordinate, sync.MapGenerationCount);
+        _companionMap = evidence;
+        return () => evidence.VoteConfirmed || run.MapLocation == evidence.Source
+            && sync.MapGenerationCount == evidence.Generation
+            && sync.GetVote(player)?.mapGenerationCount == evidence.Generation
+            && sync.GetVote(player)?.coord == coordinate;
+    }
+
+    [HarmonyPatch(typeof(EventOption), nameof(EventOption.Chosen))]
+    private static class CompanionEventTaskPatch
+    {
+        private static void Postfix(EventOption __instance, Task __result)
+        {
