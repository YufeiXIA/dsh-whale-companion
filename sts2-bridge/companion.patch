@@ -0,0 +1,119 @@
+using System;
+using System.Runtime.CompilerServices;
+using System.Threading.Tasks;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Entities.Multiplayer;
+using MegaCrit.Sts2.Core.GameActions;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.GameActions.Multiplayer;
+using MegaCrit.Sts2.Core.Multiplayer.Game;
+using MegaCrit.Sts2.Core.Multiplayer.Messages.Game;
+using MegaCrit.Sts2.Core.Multiplayer.Serialization;
+using MegaCrit.Sts2.Core.Runs;
+
+namespace STS2_MCP;
+
+public static partial class McpMod
+{
+    private static CompanionCardCancellationEvidence? _companionDispatchingCard;
+    private static CompanionCardCancellationEvidence? _companionCard;
+    private static readonly ConditionalWeakTable<ActionQueueSynchronizer, CompanionActionOrder> _companionActionOrders = new();
+
+    // Capture the exact action made by this guard dispatch, not a later action
+    // with the same card/target. Hosts execute this object. Clients correlate it
+    // to the reconstructed object using every request's reliable FIFO echo below.
+    [HarmonyPatch(typeof(ActionQueueSynchronizer), nameof(ActionQueueSynchronizer.RequestEnqueue))]
+    private static class CompanionCardRequestPatch
+    {
+        private static void Prefix(GameAction action)
+        {
+            var evidence = _companionDispatchingCard;
+            if (evidence != null && evidence.Action == null && action is PlayCardAction play
+                && ReferenceEquals(play.NetCombatCard.ToCardModel(), evidence.Card))
+                evidence.Action = play;
+        }
+    }
+
+    // Both request and echo use the same reliable ordered channel. The host
+    // synchronously echoes each request once. Track ALL local ordinary actions,
+    // including manual actions, rather than searching for a matching card.
+    [HarmonyPatch(typeof(ActionQueueSynchronizer), nameof(ActionQueueSynchronizer.RequestEnqueue))]
+    private static class CompanionClientRequestOrderPatch
+    {
+        private static void Prefix(ActionQueueSynchronizer __instance, GameAction action,
+            INetGameService ____netService, RunLocationTargetedMessageBuffer ____messageBuffer)
+        {
+            if (____netService.Type != NetGameType.Client) return;
+            var order = _companionActionOrders.GetValue(__instance, _ => new CompanionActionOrder());
+            if (!____netService.IsConnected) { order.Invalidate(); return; }
+            // This branch only stores a deferred action. RequestEnqueue is called
+            // again when it is actually sent at the start of the player turn.
+            if (action.ActionType == GameActionType.CombatPlayPhaseOnly
+                && __instance.CombatState == ActionSynchronizerCombatState.NotPlayPhase) return;
+            try { order.Sent(action, CompanionActionPayload(action, ____messageBuffer.CurrentLocation)); }
+            catch { order.Invalidate(); }
+        }
+
+        private static Exception? Finalizer(ActionQueueSynchronizer __instance, Exception? __exception)
+        {
+            if (__exception != null && _companionActionOrders.TryGetValue(__instance, out var order)) order.Invalidate();
+            return __exception;
+        }
+    }
+
+    [HarmonyPatch(typeof(ActionQueueSynchronizer), "EnqueueAction")]
+    private static class CompanionClientEchoPatch
+    {
+        private static void Prefix(ActionQueueSynchronizer __instance, GameAction action, ulong actionOwnerId,
+            INetGameService ____netService, RunLocationTargetedMessageBuffer ____messageBuffer)
+        {
+            if (____netService.Type != NetGameType.Client || actionOwnerId != ____netService.NetId) return;
+            var order = _companionActionOrders.GetValue(__instance, _ => new CompanionActionOrder());
+            try
+            {
+                object? source = order.Confirm(CompanionActionPayload(action, ____messageBuffer.CurrentLocation));
+                if (source != null && ReferenceEquals(_companionCard?.Action, source)) _companionCard.Action = action;
+            }
+            catch { order.Invalidate(); }
+        }
+    }
+
+    private static string CompanionActionPayload(GameAction action, RunLocation location)
+    {
+        var writer = new PacketWriter();
+        new RequestEnqueueActionMessage { action = action.ToNetAction(), location = location }.Serialize(writer);
+        return writer.BitPosition + ":" + Convert.ToBase64String(writer.Buffer, 0, (writer.BitPosition + 7) / 8);
+    }
+
+    [HarmonyPatch(typeof(PlayCardAction), "ExecuteAction")]
+    private static class CompanionCardExecutionPatch
+    {
+        private static void Postfix(PlayCardAction __instance, Task __result)
+        {
+            if (ReferenceEquals(_companionCard?.Action, __instance))
+                _companionCard.ExecutionTask = __result;
+        }
+    }
+
+    [HarmonyPatch(typeof(PlayCardAction), "CancelAction")]
+    private static class CompanionCardCancellationPatch
+    {
+        private static void Postfix(PlayCardAction __instance)
+        {
+            if (ReferenceEquals(_companionCard?.Action, __instance) && !_companionCard.ResourcesStarted)
+                _companionCard.CancelledBeforeResources = true;
+        }
+    }
+
+    // This boundary precedes both resource mutation and OnPlayWrapper in the
+    // installed PlayCardAction. Even a fault here makes cancellation uncertain.
+    [HarmonyPatch(typeof(CardModel), nameof(CardModel.SpendResources))]
+    private static class CompanionCardResourcesPatch
+    {
+        private static void Prefix(CardModel __instance)
+        {
+            if (ReferenceEquals(_companionCard?.Card, __instance))
+                _companionCard.ResourcesStarted = true;
+        }
+    }
+}
